# ==============================================================================
# HUSSNAIN AHMED PORTFOLIO & CMS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas Free Tier M0)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-address>/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.example.mongodb.net/portfolio?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key for signing admin session JWT tokens.
# Must be at least 32 characters long.
# Generate one in bash: openssl rand -base64 32
ADMIN_JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Default credentials used ONLY during initial admin bootstrap/seeding
ADMIN_EMAIL=admin@hussnain.dev
ADMIN_PASSWORD=replace_with_a_strong_password_minimum_12_chars

# ------------------------------------------------------------------------------
# 3. SITE METADATA & PUBLIC URL
# ------------------------------------------------------------------------------
# Canonical URL for SEO, OpenGraph images, and sitemap generation
NEXT_PUBLIC_SITE_URL=https://hussnain.dev
NEXT_PUBLIC_SITE_NAME="Hussnain Ahmed | Full-Stack Developer"

# ------------------------------------------------------------------------------
# 4. OPTIONAL CONFIGURATIONS
# ------------------------------------------------------------------------------
# Enable or disable mock data fallback if database is momentarily unreachable
# Default: true (for resilient zero-downtime display)
FALLBACK_TO_STATIC_DATA=true
